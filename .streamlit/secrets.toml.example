# Stratum — Streamlit Cloud secrets template.
# --------------------------------------------------------------------------
# Copy this file to `.streamlit/secrets.toml` for LOCAL development, or (on
# Streamlit Cloud) paste these keys into the app dashboard under
# Settings -> Secrets. NEVER commit the real secrets.toml (it is gitignored).
#
# config.py reads these automatically via st.secrets, falling back to
# os.environ / a local .env file. Missing keys are fine: the app boots in
# degraded mode and shows a banner instead of crashing.
# --------------------------------------------------------------------------

# Groq (llama-3.3-70b-versatile) — primary AI extraction backend. Free tier:
# https://console.groq.com/keys
GROQ_API_KEY = ""

# Google Gemini Flash (gemini-1.5-flash) — fallback backend. Free tier:
# https://aistudio.google.com/apikey
GOOGLE_API_KEY = ""

# Optional: Discord or Telegram webhook used by the Live Sentinel to push
# line-shift / arb / steam alerts to your phone. Can also be set in-app
# under SETTINGS (takes precedence over this value).
# STRATUM_WEBHOOK = "https://discord.com/api/webhooks/..."
